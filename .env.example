# Zona horaria del job (por defecto Europe/Madrid). La app ignora TZ del sistema.
TIMEZONE=Europe/Madrid

# Endpoint del grid de Selenium (por defecto http://127.0.0.1:4444)
SELENIUM_URL=http://127.0.0.1:4444

# Espera máxima de Selenium en segundos (por defecto 15)
SELENIUM_WAIT_SECONDS=15

# Pausas en segundos entre anuncios y entre cuentas (por defecto 0)
PAUSE_BETWEEN_LISTINGS=2
PAUSE_BETWEEN_ACCOUNTS=5

# Ruta base de datos (por defecto ./Data)
DATA_DIR=Data

# Ruta de los perfiles de Firefox (por defecto ./sessions)
PROFILES_DIR=sessions
