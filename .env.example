# Zona horaria del job (por defecto Europe/Madrid)
TZ=Europe/Madrid

# Endpoint del grid de Selenium (por defecto http://127.0.0.1:4444)
SELENIUM_URL=http://127.0.0.1:4444

# Pausas en segundos entre anuncios y entre cuentas
PAUSA_ENTRE_ANUNCIOS=2
PAUSA_ENTRE_CUENTAS=5

# Ruta base de datos (por defecto ./Data)
DATA_DIR=Data
