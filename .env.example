# Zona horaria de los jobs (por defecto Europe/Madrid). La app ignora TZ del sistema.
TIMEZONE=Europe/Madrid

# Cron de la revisión de favoritos (por defecto cada 15 minutos, en TIMEZONE)
REPLY_CRON=*/15 * * * *

# Endpoint del grid de Selenium (por defecto http://127.0.0.1:4444)
SELENIUM_URL=http://127.0.0.1:4444

# Espera máxima de Selenium en segundos (por defecto 15)
SELENIUM_WAIT_SECONDS=15

# Pausa aleatoria entre acciones de Selenium, en segundos (1,0 a 2,0 por defecto).
# Da tiempo al DOM a reaccionar. Usar 0 en ambos para desactivarla.
SELENIUM_ACTION_DELAY_MIN=1.0
SELENIUM_ACTION_DELAY_MAX=2.0

# Pausas en segundos entre anuncios y entre cuentas (por defecto 0)
PAUSE_BETWEEN_LISTINGS=2
PAUSE_BETWEEN_ACCOUNTS=5

# Ruta base de datos en el host (por defecto ./Data)
DATA_DIR=Data

# Ruta de Data dentro del contenedor de Selenium (por defecto /Data).
# docker-compose.yaml monta ./Data en ese punto como solo lectura.
SELENIUM_DATA_DIR=/Data

# Ruta de los perfiles de Firefox en el host (por defecto ./sessions)
PROFILES_DIR=sessions

# Misma carpeta dentro del contenedor de Selenium (por defecto /sessions).
# docker-compose.yaml monta ./sessions en ese punto como lectura/escritura;
# Firefox la usa in situ con -profile para conservar el login entre sesiones.
SELENIUM_PROFILES_DIR=/sessions
